fig, ax = plt.subplots(nrows=1, ncols=1) # Create a figure with one subplot
plt.subplots_adjust(left=0.20,bottom=0.20)
plt.plot(y_kom_5200,c_omega_2_pred_5200,'r--',linewidth=2, label=r'$Re_\tau = 5\, 200$')
