("\)) p n
() N
(diss_DNS=DNS_k_terms[:,7]) N
(Pk_DNS=DNS_k_terms[:,2]) N
(diff_DNS=DNS_k_terms[:,3]) N
(diff_DNS_visc =   DNS_k_terms[:,4]) N
() N
(diss_iso_DNS = np.maximum\(diss_DNS-diff_DNS_visc,0\)) N
() N
(diss_DNS=diss_DNS) N
(Pk_DNS=Pk_DNS) N
(diff_DNS=diff_DNS) N
