(# load DNS data) c n
(DNS_mean=np.genfromtxt\(") p
(LM_Channel_5200_mean_prof.dat) str
(",comments=") p
(%) str
("\)) p n
(y_DNS=DNS_mean[:,0];) N
(yplus_DNS=DNS_mean[:,1];) N
(u_DNS=DNS_mean[:,2];) N
(dudy_DNS=np.gradient\(u_DNS,yplus_DNS\)) N
() N
(DNS_stress=np.genfromtxt\(") S
(LM_Channel_5200_vel_fluc_prof.dat) str
(",comments=") p
(%) str
("\)) p n
(u2_DNS=DNS_stress[:,2];) N
(v2_DNS=DNS_stress[:,3];) N
(w2_DNS=DNS_stress[:,4];) N
(uv_DNS=DNS_stress[:,5];) N
(k_DNS=0.5*\(u2_DNS+v2_DNS+w2_DNS\)) N
(dkdy_DNS=np.gradient\(k_DNS,yplus_DNS,edge_order=2\)) N
(d2kdy2_DNS=np.gradient\(dkdy_DNS,yplus_DNS,edge_order=2\)) N
() N
